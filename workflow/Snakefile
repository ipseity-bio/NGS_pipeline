from pathlib import Path

configfile: "config/config.yaml"

INPUT_DIR = Path(config["input_dir"]).resolve()
OUTPUT_DIR = Path(config["output_dir"]).resolve()

REFERENCES = config["references"]
FILTERS = config["filter_thresholds"]
HARD_FILTERS = config["gatk_hard_filters"]
DEDUP = config.get("duplicate_handling", {})
READ_GROUP_CONFIG = config.get("read_groups", {})
RESOURCES = config["resources"]
CONTAINERS = config["containers"]
POSTPROCESS = config["postprocess"]

REF = Path(REFERENCES["ref"]).resolve()
BWA_INDEX = Path(REFERENCES["bwa_index"]).resolve()
KNOWN_SITES = Path(REFERENCES["known_sites"]).resolve()
BED_PATH = Path(REFERENCES["bed_file"]).resolve()
VEP_CACHE = Path(REFERENCES["vep_cache"]).resolve()

FASTQ_R1_SUFFIX = "_R1_001.fastq.gz"
FASTQ_R2_SUFFIX = "_R2_001.fastq.gz"

sample_names = sorted(
    path.name[: -len(FASTQ_R1_SUFFIX)]
    for path in INPUT_DIR.glob(f"*{FASTQ_R1_SUFFIX}")
)

if not sample_names:
    raise ValueError(
        f"No FASTQ files matching '*{FASTQ_R1_SUFFIX}' were found in {INPUT_DIR}"
    )

LOG_DIR = OUTPUT_DIR / "logs"
FASTP_DIR = OUTPUT_DIR / "fastp"
ALIGN_DIR = OUTPUT_DIR / "alignment"
VARIANT_DIR = OUTPUT_DIR / "variants"
ANNOTATION_DIR = OUTPUT_DIR / "annotation"
COMPARE_DIR = OUTPUT_DIR / "compare"
REPORT_DIR = OUTPUT_DIR / POSTPROCESS["report_dir"]
COVERAGE_DIR = OUTPUT_DIR / POSTPROCESS["coverage_dir"]
PSEUDOGENE_DIR = REPORT_DIR / "pseudogene"
COVERAGE_SUMMARY = REPORT_DIR / f"{OUTPUT_DIR.name}_coverage_summary.csv"


def input_fastq(sample, read):
    suffix = FASTQ_R1_SUFFIX if read == "R1" else FASTQ_R2_SUFFIX
    return str(INPUT_DIR / f"{sample}{suffix}")



def parse_scalar(value):
    value = value.strip()
    if not value:
        return ""
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    lowered = value.lower()
    if lowered == "true":
        return True
    if lowered == "false":
        return False
    return value


def load_simple_yaml(path):
    root = {}
    stack = [(-1, root)]
    with open(path, "r", encoding="utf-8") as handle:
        for raw in handle:
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            indent = len(line) - len(line.lstrip(" "))
            stripped = line.strip()
            if ":" not in stripped:
                raise ValueError(f"Unsupported read-group metadata line: {line}")
            field, value = stripped.split(":", 1)
            field = field.strip()
            value = value.strip()
            while stack and indent <= stack[-1][0]:
                stack.pop()
            parent = stack[-1][1]
            if value == "":
                parent[field] = {}
                stack.append((indent, parent[field]))
            else:
                parent[field] = parse_scalar(value)
    return root


READ_GROUPS = {}
if READ_GROUP_CONFIG.get("enabled", False):
    read_group_file = Path(READ_GROUP_CONFIG["metadata_file"]).resolve()
    READ_GROUPS = load_simple_yaml(read_group_file).get("samples", {})


def read_group_string(sample):
    values = {
        "ID": sample,
        "SM": sample,
        "LB": "lib1",
        "PL": "ILLUMINA",
        "PU": "unit1",
    }
    if READ_GROUP_CONFIG.get("enabled", False):
        sample_values = READ_GROUPS.get(sample)
        if sample_values is None:
            raise ValueError(
                f"Read-group metadata is enabled, but sample '{sample}' is missing from "
                f"{READ_GROUP_CONFIG['metadata_file']}"
            )
        values.update(
            {key: value for key, value in sample_values.items() if value not in [None, ""]}
        )
        values["SM"] = values.get("SM") or sample
        values["ID"] = values.get("ID") or sample

    ordered_keys = ["ID", "SM", "LB", "PL", "PU", "CN", "DT"]
    return "@RG" + "".join(
        f"\\t{key}:{values[key]}" for key in ordered_keys if values.get(key)
    )


rule all:
    input:
        expand(str(REPORT_DIR / "{sample}_all_candidates.csv"), sample=sample_names),
        expand(str(REPORT_DIR / "{sample}_raw_output.csv"), sample=sample_names),
        expand(str(REPORT_DIR / "{sample}_output_p.csv"), sample=sample_names),
        expand(str(REPORT_DIR / "{sample}_raw_output_filtered_tp.csv"), sample=sample_names),
        expand(str(REPORT_DIR / "{sample}_raw_output_filtered_tp_report.csv"), sample=sample_names),
        expand(str(PSEUDOGENE_DIR / "{sample}_filtered_pseudogene_variants.txt"), sample=sample_names),
        str(COVERAGE_SUMMARY),
        str(REPORT_DIR / "true_positive.zip"),
        str(REPORT_DIR / "true_positive_report.zip"),
        str(REPORT_DIR / ".postprocess.done")


