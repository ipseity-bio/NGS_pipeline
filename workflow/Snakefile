from pathlib import Path

configfile: "config/config.yaml"

INPUT_DIR = Path(config["input_dir"]).resolve()
OUTPUT_DIR = Path(config["output_dir"]).resolve()

REFERENCES = config["references"]
FILTERS = config["filter_thresholds"]
RESOURCES = config["resources"]
CONTAINERS = config["containers"]

REF = Path(REFERENCES["ref"]).resolve()
BWA_INDEX = Path(REFERENCES["bwa_index"]).resolve()
KNOWN_SITES = Path(REFERENCES["known_sites"]).resolve()
BED_PATH = Path(REFERENCES["bed_file"]).resolve()
VEP_CACHE = Path(REFERENCES["vep_cache"]).resolve()

FASTQ_R1_SUFFIX = "_R1_001.fastq.gz"
FASTQ_R2_SUFFIX = "_R2_001.fastq.gz"

sample_names = sorted(
    path.name[: -len(FASTQ_R1_SUFFIX)]
    for path in INPUT_DIR.glob(f"*{FASTQ_R1_SUFFIX}")
)

if not sample_names:
    raise ValueError(
        f"No FASTQ files matching '*{FASTQ_R1_SUFFIX}' were found in {INPUT_DIR}"
    )

LOG_DIR = OUTPUT_DIR / "logs"
FASTP_DIR = OUTPUT_DIR / "fastp"
ALIGN_DIR = OUTPUT_DIR / "alignment"
VARIANT_DIR = OUTPUT_DIR / "variants"
ANNOTATION_DIR = OUTPUT_DIR / "annotation"
COMPARE_DIR = OUTPUT_DIR / "compare"


def input_fastq(sample, read):
    suffix = FASTQ_R1_SUFFIX if read == "R1" else FASTQ_R2_SUFFIX
    return str(INPUT_DIR / f"{sample}{suffix}")


rule all:
    input:
        expand(str(ANNOTATION_DIR / "{sample}_merged_vep.vcf"), sample=sample_names)


include: "rules/preprocess.smk"
include: "rules/calling.smk"
include: "rules/annotation.smk"
